# DevGate Spec Coherence Service — pinned evaluation image.
#
# Stdlib-only Python service: no pip install, no network at runtime, no
# writable layer use in production (the launcher applies --read-only,
# non-root, cap-drop ALL; see hub/coherence/launcher.py).
#
# The base is pinned by INDEX digest (resolved via the registry
# Docker-Content-Digest header, verified by an actual pull) so every
# platform resolves the same upstream manifest list — coh-rt-01 requires
# digest-pinned invocation, never a tag.
#
# Build (reproducible-ish; fixed timestamps):
#   podman build --timestamp 0 -t devgate-coherence -f container/Containerfile .
#   podman image inspect --format '{{.Digest}}' devgate-coherence   # local build
#
# Record the platform + the digest THE REGISTRY SERVES in
# container/execution-profiles.json (coh-id-04 identity registry) — which is
# NOT the local build's digest. Measured 2026-09-23: pushing re-encodes the
# manifest, so `podman image inspect` of a locally built image names bytes the
# registry does not have (local 2eff3fd9…, served f470110c… for the same
# bytes) and `podman pull image@2eff3fd9…` fails with "manifest unknown".
# Recording the local value is how the S4 pin shipped unpullable. Re-resolve
# the pushed ref instead:
#   podman pull --quiet "$IMAGE:main"
#   podman image inspect --format '{{.Digest}}' "$IMAGE:main"
# Publish (CI): podman push devgate-coherence \
#   ghcr.io/thearchitectit/aiggp-agentic-framework/devgate-coherence
# The repository half is NOT hand-written: ci.yml derives it from
# ${GITHUB_REPOSITORY,,}, so publish and pull agree with the repo that ran the
# job. This comment was the last survivor of the `devgate-*` → `aiggp-*` name
# sweep (dadfd1d moved the registry, the template pin, and the schema $id; the
# sweep commit 387fd09 names this class) and still said
# `devgate-agentic-framework` — a path no workflow has ever pushed to.
# `.containerignore` keeps the context to tracked source: untracked
# __pycache__ in a working tree otherwise rides into the image (measured: 33
# entries, config digest 8ca8ac95… — vs ef02f38a… for the same source built
# from a clean checkout), making the recorded identity unreproducible.

FROM docker.io/library/python@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

RUN groupadd --system coherence \
    && useradd --system --gid coherence --home /tmp coherence

WORKDIR /app

# Copy the service package (stdlib only). The frozen contract schemas live at
# hub/coherence/schemas/ — inside this COPY — and schemacheck.SCHEMA_DIR
# resolves relative to the package, so the image carries its own contracts
# with no extra copy (coh-rt-08, F1/D2). Pinned by a podman-free unit in
# tests/test_hub_coherence_container.py.
COPY hub/ ./hub/

USER coherence

# One evaluation per invocation; the launcher passes --request / output
# binds and enforces network=none outside the container.
ENTRYPOINT ["python3", "-m", "hub.coherence"]
