# DevGate runner-monitor hub — Podman quadlet template.
#
# The hub is a small stdlib-only Python service (no pip dependencies). It
# binds one port, reads/writes runners.json + alerts/*.jsonl on a named
# volume, and polls the GitHub API for runner/queue/gate/drift status.
#
# Copy to monitor-hub:
#   ~/.config/containers/systemd/devgate-hub.container
# Then:
#   systemctl --user daemon-reload
#   systemctl --user start devgate-hub
#   systemctl --user status devgate-hub
#
# Secrets (GITHUB_TOKEN, HUB_ENROLLMENT_TOKENS) come from ONE canonical
# mechanism, declared in this file — a raw env file read at unit start
# (leading '-' = optional, so a hub without a PAT still starts in
# polling-disabled mode) — NEVER hardcoded here (this repo is public):
#   ~/.config/containers/systemd/devgate-hub.secrets.env   (chmod 600)
#     GITHUB_TOKEN=ghp_...          # fine-grained PAT, actions:read + issues:write
#     HUB_ENROLLMENT_TOKENS=tok1,tok2,...  # one-time enrollment tokens
#   No pepper is required: heartbeat verifiers are salted-hashed in
#   runners.json (the salt is generated and stored in the registry itself).
#
# Podman quadlet format (podman 5.8+). See `podman-systemd.unit(5)`.

[Container]
# Build the image from the in-repo Containerfile first:
#   podman build -t devgate-hub:local -f templates/runner-monitor/Containerfile .
Image=devgate-hub:local

# Secrets env file (optional; see header). RAW env-file format read by the
# unit itself — NOT a quadlet drop-in (drop-ins are INI fragments and a raw
# env file there does not parse).
EnvironmentFile=-%h/.config/containers/systemd/devgate-hub.secrets.env

# Friendly container name shown in `podman ps`.
ContainerName=devgate-hub

# Hostname visible inside the container (cosmetic).
HostName=devgate-hub

# --- Network ---
# The hub binds 0.0.0.0:8443 INSIDE the container; monitor-hub's host firewall
# restricts access to enrolled runner hosts only (D7). We publish the port
# on the host so spokes can reach it at http://<monitor-hub-host>:8443.
PublishPort=8443:8443

# --- Configuration (non-secret defaults; override via drop-in) ---
Environment=HUB_BIND_HOST=0.0.0.0
Environment=HUB_BIND_PORT=8443
Environment=HUB_DATA_DIR=/data
# Q1–Q3 defaults (see docs/runner-monitor-monitor-hub.md for owner confirmation):
Environment=HUB_ALERT_CHANNEL=github_issue
Environment=HUB_HEARTBEAT_INTERVAL_SEC=300
Environment=HUB_MONITOR_ONLY=true
# GITHUB_TOKEN and HUB_ENROLLMENT_TOKENS are intentionally NOT set here —
# provide via the secrets env file above (chmod 600, never committed).

# --- Persistent volume ---
# runners.json + alerts/*.jsonl live here. Survives container recreation.
Volume=devgate-hub-data:/data

# --- Logging ---
# k8s-file (readable via `podman logs devgate-hub`). journald is NOT used:
# rootless user journald is often absent on monitor-hub, which would leave service
# failures invisible.
LogDriver=k8s-file

[Service]
# Always restart on failure or clean stop.
Restart=always
RestartSec=10

# Graceful stop timeout (seconds) before SIGKILL. The hub handles SIGTERM
# for a clean shutdown (flushes runners.json).
TimeoutStopSec=30

[Install]
# Enable so the unit starts on boot / user login. Requires linger enabled:
#   loginctl enable-linger $USER
WantedBy=default.target
