# DevGate self-hosted GitHub Actions runner — Podman quadlet template.
#
# STANDARD: run the official GitHub Actions runner image from ghcr.io. Do NOT
# hand-roll a runner image; ghcr.io/actions/actions-runner is the canonical,
# MIT-licensed, GitHub-maintained base. PIN A DIGEST — the Image= line below
# is pinned (tag `latest` resolved 2026-09-19; tag recorded for humans only).
#
# Copy to the runner host:
#   ~/.config/containers/systemd/<project>-runner.container
# Then:
#   systemctl --user daemon-reload
#   systemctl --user start <project>-runner
#   systemctl --user status <project>-runner
#
# Podman quadlet format (podman 5.8+). See `podman-systemd.unit(5)`.
# Docker equivalent: translate [Container] keys to `docker run` flags / compose.

[Container]
# Official GitHub Actions runner image. The base ships the runner agent, the
# k8s container hooks, and a docker CLI so jobs can build containers. Add
# language toolchains (rust, node, python, go, ...) via a child image ONLY if
# your gates need them — most DevGate gates are python3 + node + shell, which
# this base already satisfies.
# Rotation: podman pull ghcr.io/actions/actions-runner:latest; podman image
# inspect --format '{{index .RepoDigests 0}}' ghcr.io/actions/actions-runner
# and update the digest + date comment together.
Image=ghcr.io/actions/actions-runner@sha256:e5496277be5d09bc968b3d64911b74e219ac4a3f2edce956a3ecf9271bea1ef4

# Friendly container name shown in `podman ps`.
ContainerName=devgate-runner

# Hostname visible inside the container (cosmetic).
HostName=devgate-runner

# --- Runner registration (provided by GitHub) ---
# The registration token is one-time and ephemeral. NEVER hardcode a real token
# in this file — this repo is public. ONE canonical mechanism, declared here:
# a raw env file read at unit start (leading '-' = optional; a missing file
# then fails registration with the runner's own error message):
#   ~/.config/containers/systemd/devgate-runner.secrets.env   (chmod 600)
#   RUNNER_TOKEN=<one-time-token>
EnvironmentFile=-%h/.config/containers/systemd/devgate-runner.secrets.env
Environment=RUNNER_NAME=devgate-runner
# Label(s) your workflows target with `runs-on:`. One container per project:
# give each project a DISTINCT label so jobs never cross project boundaries.
Environment=RUNNER_LABELS=devgate
# Scope: "repo" (single repo) or "org" (whole org). Repo-scoped is the
# fail-closed default — jobs targeting an unregistered label queue, no
# hosted-runner fallback.
Environment=RUNNER_SCOPE=repo
# The repo (or org) this runner registers against.
Environment=REPO_URL=https://github.com/OWNER/REPO
Environment=RUNNER_WORKDIR=/_work
# Durable registration: persist the runner identity on the work volume so a
# restart REUSES the existing GitHub registration instead of re-running
# ./config.sh (which would require a fresh one-time token every start).
# The image requires DISABLE_AUTOMATIC_DEREGISTRATION=true with reusage.
Environment=CONFIGURED_ACTIONS_RUNNER_FILES_DIR=/_work/runner-config
Environment=DISABLE_AUTOMATIC_DEREGISTRATION=true
# RUNNER_TOKEN is intentionally NOT set here — set via the secrets env file above.

# --- Work volume ---
# Persistent working directory so jobs share /_work across runs. A named volume
# survives container recreation and keeps caches warm.
Volume=devgate-runner-work:/_work

# --- Ephemeral behaviour ---
# We do NOT set EPHEMERAL=1 by default; durable registration is the standard.
# For a throwaway runner that registers fresh on every start, uncomment:
# Environment=EPHEMERAL=1

# --- Logging ---
# k8s-file (readable via `podman logs devgate-runner`). journald is NOT used:
# rootless user journald is often absent (no /run/user/UID/journal socket),
# which leaves service failures invisible.
LogDriver=k8s-file

[Service]
# Always restart on failure or clean stop.
Restart=always
RestartSec=10

# Graceful stop timeout (seconds) before SIGKILL.
TimeoutStopSec=30

[Install]
# Enable so the unit starts on boot / user login.
WantedBy=default.target
