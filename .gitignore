# Dependencies
node_modules/
vendor/
__pycache__/
*.pyc
dist/
build/
target/
out/

# Environment
.env
.env.*
!.env.example

# OS
.DS_Store

# Logs
*.log

# FORBIDDEN — package manager is the ONLY distribution path (PREVENT-DIST-001).
# Never produce or commit a `.tgz` tarball; tarballs bypass the package manager
# and don't propagate to other devices. Use `npm publish` / `cargo publish` /
# `pip install` / etc. only.
*.tgz

# Local runtime state
.devgate-state/
.cache/

# Runner-monitor instance state (hub volume on monitor-hub) — NEVER commit (mon-registry-01)
runners.json
alerts/*.jsonl
~/.devgate-heartbeat.env
.devgate-heartbeat.env
# Database files (if using SQLite — add your own DB patterns here)
*.db
*.db-shm
*.db-wal

# Playwright scratch
.playwright-mcp/
*-tab-fixed.png

# Local agent/session state (never track)
.claude/
.crew/
.claw/
.clawd-todos.json

# Python bytecode
__pycache__/
*.pyc

# Rust build artifacts
**/target/
Cargo.lock

# Go build artifacts
*.exe
*.dll
*.so
*.dylib

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Temp
tmp/
.pi/

# Machine-specific runner/fleet details (hostnames, IPs, token drop-ins,
# volume layout, incident log) live in the operator's private infra repo.
# The public DevGate repo stays generic by design — see the
# "add-a-runner-to-fleet" OpenSpec change and the private infra record
# for the real fleet topology per mon-registry-01.
