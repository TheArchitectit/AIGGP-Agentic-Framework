{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TheArchitectit/DevGate-Agentic-Framework/hub/coherence/schemas/policy-bundle.schema.json",
  "title": "devgate.spec-coherence.policy/v1 central policy bundle",
  "description": "Central minimum policy. Resolves from control-plane trust roots; repository overlay may strengthen only; anti-rollback applies (coh-pol-01, coh-pol-02).",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "policy_version", "required_assertions", "approved_evaluators", "approved_signers", "stages"],
  "properties": {
    "api_version": { "const": "devgate.spec-coherence.policy/v1" },
    "policy_version": { "type": "string" },
    "min_bundle_epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "Anti-rollback floor: bundles with epoch below this are rejected unless grandfathered."
    },
    "required_assertions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Assertion IDs central policy requires on every evaluated repo."
    },
    "assertion_severity_floor": {
      "type": "object",
      "additionalProperties": { "enum": ["critical", "high", "medium", "low"] },
      "description": "Central severity floors; a repository cannot lower severity below this."
    },
    "approved_evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest"],
        "properties": {
          "id": { "type": "string" },
          "digest": { "$ref": "#/definitions/digest" }
        }
      }
    },
    "approved_signers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "identity"],
        "properties": {
          "key_id": { "type": "string" },
          "identity": { "type": "string" },
          "valid_from": { "type": ["string", "null"], "format": "date-time" },
          "valid_until": { "type": ["string", "null"], "format": "date-time" },
          "revoked": { "type": "boolean", "default": false }
        }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_advisory_age_days"],
      "properties": {
        "max_advisory_age_days": { "type": "integer", "minimum": 1 },
        "stage_definitions": {
          "type": "array",
          "items": { "type": "integer", "enum": [0, 1, 2, 3, 4] }
        }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
