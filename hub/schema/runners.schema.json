{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TheArchitectit/DevGate-Agentic-Framework/hub/schema/runners.schema.json",
  "title": "DevGate runner-monitor registry (instance state, never committed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runners"],
  "properties": {
    "version": { "const": 1 },
    "token_salt": {
      "description": "Per-registry salt for heartbeat-token hashing (mon-sec-02). Generated on first use and persisted; heartbeat verifiers are stored only as salted hashes.",
      "type": "string"
    },
    "enrollment_tokens": {
      "description": "One-time enrollment tokens; consumed on successful /enroll.",
      "type": "array",
      "items": { "type": "string" }
    },
    "runners": {
      "type": "array",
      "items": { "$ref": "#/definitions/runner" }
    }
  },
  "definitions": {
    "runner": {
      "type": "object",
      "required": ["name", "repo", "enrolled_at", "heartbeat_token_hash"],
      "properties": {
        "name": { "type": "string" },
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "host_alias": { "type": "string" },
        "enrolled_at": { "type": "string", "format": "date-time" },
        "heartbeat_token_hash": {
          "description": "Salted sha256 of the heartbeat token — the plaintext token is never stored (mon-sec-02). Null after revocation.",
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "last_heartbeat": { "type": ["string", "null"], "format": "date-time" },
        "last_job_seen": { "type": ["string", "null"] },
        "disk_ok": { "type": ["boolean", "null"] },
        "podman_ok": { "type": ["boolean", "null"] },
        "enrolled": { "type": "boolean", "default": true },
        "queue_threshold_min": { "type": "number" },
        "drift_period_min": { "type": "number" }
      }
    }
  }
}
