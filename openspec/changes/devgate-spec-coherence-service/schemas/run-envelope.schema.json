{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TheArchitectit/AIGGP-Agentic-Framework/openspec/changes/devgate-spec-coherence-service/schemas/run-envelope.schema.json",
  "title": "devgate.spec-coherence.run-envelope/v1",
  "description": "Noncanonical transport envelope. Written LAST in the acyclic sealing order; references the detached attestation location.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "decision", "exit_code", "stage", "semantics", "attestation_required", "signed", "artifacts"],
  "properties": {
    "api_version": { "const": "devgate.spec-coherence.envelope/v1" },
    "decision": { "enum": ["PASS", "ADVISORY", "FAIL", "ERROR"] },
    "exit_code": { "type": "integer" },
    "stage": { "type": "integer" },
    "semantics": { "enum": ["fresh-promotion", "replay"] },
    "attestation_required": { "type": "boolean" },
    "signed": { "type": "boolean" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "evidence_manifest", "attestation"],
      "properties": {
        "result": { "type": "string" },
        "evidence_manifest": { "type": "string" },
        "attestation": { "type": ["string", "null"] }
      }
    }
  }
}
