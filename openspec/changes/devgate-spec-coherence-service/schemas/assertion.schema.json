{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TheArchitectit/DevGate-Agentic-Framework/openspec/changes/devgate-spec-coherence-service/schemas/assertion.schema.json",
  "title": "devgate.spec-coherence.assertion/v1",
  "description": "Operational assertion model (coh-assert-01..06). Every required property is machine-readable; identity assertions compare against approved package values; release manifests bind an inner payload digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "requirement_refs", "owner", "requirement", "subjects", "evaluator", "parameters", "severity", "dependencies", "finding_key", "evidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Normative requirement IDs in the package this assertion traces to."
    },
    "owner": { "type": "string" },
    "requirement": { "type": "string" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/subjectSelector" }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "type": "string" },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "parameters": { "type": "object", "description": "Validated against the evaluator's published parameter schema." },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "finding_key": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["assertion_id", "subject_location", "violation_class"] },
      "description": "Fields composing the stable content-derived finding key."
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_days"],
      "properties": {
        "retention_days": { "type": "integer", "minimum": 0 },
        "minimum_disclosure": { "type": "boolean", "default": true }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subjectSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["file", "artifact-metadata", "directory", "captured-fact"] },
        "path": { "type": "string" },
        "selector": { "type": "string", "description": "Typed selector; empty resolution is UNRESOLVED, never SATISFIED." },
        "extract": { "type": "string", "description": "Declared, versioned extraction rule." },
        "fact_id": { "type": "string" }
      }
    }
  }
}
