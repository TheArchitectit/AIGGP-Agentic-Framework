{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TheArchitectit/AIGGP-Agentic-Framework/openspec/changes/devgate-spec-coherence-service/schemas/signer-set.schema.json",
  "title": "devgate.spec-coherence.signer-set/v1",
  "description": "HMAC pilot stand-in per ADR-018: symmetric verification keys travel in the control-plane-issued set; production splits signing/verification keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "as_of", "signers"],
  "properties": {
    "api_version": { "const": "devgate.spec-coherence.signer-set/v1" },
    "as_of": { "type": "string", "format": "date-time", "description": "Reference time for validity window checks." },
    "signers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "identity", "key", "valid_from", "valid_until"],
        "properties": {
          "key_id": { "type": "string" },
          "identity": { "type": "string" },
          "key": { "type": "string", "pattern": "^[0-9a-f]{64,}$", "minLength": 64, "description": "Hex-encoded HMAC key (minimum 32 bytes = 64 hex chars)." },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_until": { "type": "string", "format": "date-time" },
          "revoked": { "type": "boolean", "default": false },
          "revoked_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
