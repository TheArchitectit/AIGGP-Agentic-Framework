{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/TheArchitectit/DevGate-Agentic-Framework/.guardrails/prevention-rules/pattern-rules.schema.json",
  "description": "JSON Schema for validating pattern-rules.json — language-agnostic prevention rules for regression detection",
  "type": "object",
  "required": ["$schema", "description", "version", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule" }
    }
  },
  "definitions": {
    "severity": { "type": "string", "enum": ["critical", "error", "warning", "info"] },
    "rule": {
      "type": "object",
      "required": ["rule_id", "name", "enabled", "pattern", "severity", "message"],
      "additionalProperties": true,
      "properties": {
        "rule_id": { "type": "string", "pattern": "^PREVENT(-[A-Z]+)?-\\d+$" },
        "name": { "type": "string" },
        "enabled": { "type": "boolean" },
        "pattern": { "type": "string" },
        "severity": { "$ref": "#/definitions/severity" },
        "message": { "type": "string" },
        "file_glob": { "type": "array", "items": { "type": "string" } },
        "forbidden_context": { "type": ["string", "null"] },
        "suggestion": { "type": "string" }
      }
    }
  }
}
